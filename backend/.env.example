# Paths are relative to backend/, regardless of the working directory.
CRYO_DATABASE_PATH=data/cryocore.sqlite3
# Raw NISAR downloads (data/raw) and published case bundles (data/cases). Needs ~13 GB for the curated case.
CRYO_DATA_DIR=data
CRYO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CRYO_NASA_TIMEOUT_SECONDS=30
# Public metadata discovery (sync, /api/v1/explorer) needs no credentials.
# NISAR HDF5 downloads need NASA Earthdata Login: https://urs.earthdata.nasa.gov/ -> Generate Token.
# Alternatively put "machine urs.earthdata.nasa.gov login <user> password <pass>" in ~/.netrc (or ~/_netrc).
CRYO_EARTHDATA_TOKEN=
# Required in the X-Admin-Token header of POST /api/v1/jobs. Leave empty to disable job creation over HTTP.
CRYO_ADMIN_TOKEN=
# CRYO_JOB_MAX_ATTEMPTS=3
# CRYO_JOB_STALE_SECONDS=3600
# QA only: serve a bundle built from synthetic test fixtures (never set this in a real deployment)
# CRYO_ALLOW_SYNTHETIC_QA=0
