# Paths are relative to backend/, regardless of the working directory.
CRYO_DATABASE_PATH=data/cryocore.sqlite3
# Curated-case worker: raw NISAR downloads (data/raw) and published bundles (data/cases). Needs ~13 GB for the curated case.
CRYO_DATA_DIR=data
CRYO_DOWNLOAD_DIRECTORY=data/downloads
CRYO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CRYO_NASA_TIMEOUT_SECONDS=30
# Public metadata discovery needs no NASA credentials.
# NISAR HDF5 downloads need NASA Earthdata Login: https://urs.earthdata.nasa.gov/ -> Generate Token.
# The curated-case worker can instead use "machine urs.earthdata.nasa.gov login <user> password <pass>" in ~/.netrc (or ~/_netrc).
# Server-side only. Never add this token to NEXT_PUBLIC_* variables.
EARTHDATA_TOKEN=
# Required in the X-Admin-Token header of POST /api/v1/jobs. Leave empty to disable job creation over HTTP.
CRYO_ADMIN_TOKEN=
# CRYO_JOB_MAX_ATTEMPTS=3
# CRYO_JOB_STALE_SECONDS=3600
# QA only: serve a bundle built from synthetic test fixtures (never set this in a real deployment)
# CRYO_ALLOW_SYNTHETIC_QA=0
# Case assistant (sidebar chat): a Google AI Studio key, server-side only. Leave empty to disable the assistant.
GEMINI_API_KEY=
# CRYO_GEMINI_MODEL=gemini-3.5-flash
# Used when the main model is busy (503), hanging or out of quota (429); empty to disable.
# CRYO_GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Questions per minute across all viewers (each costs Gemini calls on this key)
# CRYO_ASSISTANT_REQUESTS_PER_MINUTE=20
